# Copy to .env.local and fill in from the KerjaReady stack outputs (UserPoolId, UserPoolClientId, Cognito domain)
VITE_USER_POOL_ID=
VITE_USER_POOL_CLIENT_ID=
# Cognito domain without https://, for example kerjaready.auth.ap-southeast-5.amazoncognito.com
VITE_COGNITO_DOMAIN=
# API Gateway URL without a trailing slash, for example https://abc123.execute-api.ap-southeast-5.amazonaws.com
VITE_API_URL=
